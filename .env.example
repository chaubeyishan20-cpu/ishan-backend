# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/sbl
# Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/sbl
MONGO_URI=mongodb://127.0.0.1:27017/sbl

# Port the Express server listens on
PORT=5000

# Secret used to sign JWT tokens (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# CORS origin for the frontend (comma-separated if needed)
# CORS_ORIGIN=http://localhost:3000